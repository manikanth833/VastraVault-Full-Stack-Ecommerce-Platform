# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
# Production must list the real domain(s), comma-separated, with no protocol
# and no trailing slash. Example: api.ananyasarees.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Security headers must stay False/0 for local HTTP development.
# For production HTTPS deployment, set these to True / a positive value only
# after HTTPS is confirmed working. Otherwise the dev server can become unreachable
# because SSL redirects loop and secure-only cookies will not be sent over HTTP.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSP_REPORT_ONLY=True

# Database Settings
DATABASE_ENGINE=postgres
DATABASE_NAME=ananyadb
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis Caching & Celery Broker
REDIS_URL=redis://redis:6379/0

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email Configurations (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ananya Sarees <noreply@ananyasarees.com>
